[user]
    name = Andre Azzolini
    email = andre@azzolini.io
[core]
    excludesfile = ~/.gitignore
    quotepath = false
    editor = nvim
    autocrlf = input
    commentchar = ";"
    pager = delta
    untrackedCache = true
    fsmonitor = false
[delta]
    side-by-side = false
    hunk-header-style = omit
    paging = never
    syntax-theme = "wave"
    true-color = always
    line-numbers = true
    line-numbers-minus-style = red
    line-numbers-zero-style = 246
    line-numbers-plus-style = green
    minus-empty-line-marker-style = omit
    plus-empty-line-marker-style = omit
    zero-style = syntax
    minus-style = syntax "#2f2233"
    minus-non-emph-style = syntax "#2f2233"
    minus-emph-style = syntax "#610641"
    plus-style = syntax "#193237"
    plus-non-emph-style = syntax "#193237"
    plus-emph-style = syntax "#0f5f5d"
[push]
    default = current
    autoSetupRemote = true
[pull]
    rebase = true
[github]
    user = apazzolini
    email = andre@azzolini.io
[color]
    ui = true
[color "status"]
    changed = yellow
    added = green
    untracked = cyan
[alias]
    di = diff
    ds = diff --staged
    dp = diff @{push}..HEAD
    st = status
    ca = commit --amend
    can = commit --amend --no-edit
    aa = add --all
    co = checkout --ignore-other-worktrees
    br = branch
    s = stash
    hist = log --pretty=format:\"%h %ad [%an] | %s%d\" --graph --decorate --date=short
    cm = commit -m
    pr = pull --rebase
    pnv = push --no-verify
    pf = push --force-with-lease
    pfa = "!sh -c 'name=$0 && (git branch --format=\"%(refname:short)\" | grep \"$name\" | xargs -I {} git push --force-with-lease origin {})'"
    ri = rebase --interactive
    wt = worktree
    rom = "!git reset --hard && git clean -fd && git checkout --ignore-other-worktrees master && git reset --hard origin/master"
    from = "!git reset --hard && git clean -fd && git checkout --ignore-other-worktrees master && git fetch && git reset --hard origin/master"
    ro = "!git reset --hard && git clean -fd && git reset --hard origin/master"
    fro = "!git reset --hard && git clean -fd && git fetch && git reset --hard origin/master"
    work = "!git fetch && git checkout origin/develop --ignore-other-worktrees --no-track -b \"$@\""
    wip = "!git add --all && git commit -m 'wip'"
    rdp = "!git range-diff origin/master origin/$(git branch --show-current) HEAD"

    find-merge = "!sh -c 'commit=$0 && branch=${1:-HEAD} && (git rev-list $commit..$branch --ancestry-path | cat -n; git rev-list $commit..$branch --first-parent | cat -n) | sort -k2 -s | uniq -f1 -d | sort -n | tail -1 | cut -f2'"


    # Fancy logging.
    #   h = head
    #   hp = head with patch
    #   r = recent commits, only current branch
    #   ra = recent commits, all reachable refs
    #   l = all commits, only current branch
    #   la = all commits, all reachable refs
    #   b = all branches
    #   bs = all branches, sorted by last commit date
    head = !git r -1
    h = !git head
    hp = "!. ~/.githelpers && show_git_head"
    r = !GIT_NO_PAGER=1 git l -30
    ra = !git r --all
    l = "!. ~/.githelpers && pretty_git_log"
    la = !git l --all
    b = "!. ~/.githelpers && pretty_git_branch"
    bs = "!. ~/.githelpers && pretty_git_branch_sorted"
[diff]
    tool = vimdiff
    algorithm = histogram
    ; colorMoved = plain
    mnemonicPrefix = true
    renames = true
[color "diff-highlight"]
    oldNormal = red
    oldHighlight = red "#500000"
    newNormal = green
    newHighlight = green "#003000"
[color "diff"]
    meta = 11
    frag = magenta bold
    commit = yellow bold
    old = red
    new = green
    whitespace = "#ffff00" reverse
[include]
    path = ~/.gitconfig.local
[branch]
  autosetuprebase = always
[rerere]
    enabled = true
    autoupdate = true
[commit]
    verbose = true
[init]
    defaultBranch = master
[fetch]
    prune = true
    pruneTags = true
    all = true
[rebase]
    updateRefs = true
    autoSquash = true
    autoStash = true
; [merge]
;     conflictstyle = zdiff3
[feature]
    manyFiles = true
