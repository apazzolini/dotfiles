wt () {
  _wtn_start () {
    local root="$1"
    local pool_size="$2"
    local name="$3"
    local no_tmux="$4"
    local review=0
    local target
    local branch
    local idx
    local slot=""

    if [[ "$name" == review/* ]]; then
      review=1
      name="review-${name#review/}"
    fi

    if [[ "$name" == */* ]]; then
      echo "worktree names cannot contain /"
      return 1
    fi

    if [[ "$name" == open<-> ]]; then
      echo "worktree names matching open<number> are reserved for the pool"
      return 1
    fi

    target="$root/$name"
    branch="andre/$name"

    if [[ -e "$target" ]]; then
      echo "worktree $name already exists"
      return 1
    fi

    if (( ! review )) && ! git -C "$root" check-ref-format --branch "$branch" >/dev/null 2>&1; then
      echo "invalid branch name: $branch"
      return 1
    fi

    for (( idx = 0; idx < pool_size; idx++ )); do
      if [[ -d "$root/open$idx" ]]; then
        slot="$root/open$idx"
        break
      fi
    done

    if [[ -z "$slot" ]]; then
      _wtn_init_pool "$root" "$pool_size" || return

      for (( idx = 0; idx < pool_size; idx++ )); do
        if [[ -d "$root/open$idx" ]]; then
          slot="$root/open$idx"
          break
        fi
      done
    fi

    if [[ -z "$slot" ]]; then
      echo "no open worktrees available"
      return 1
    fi

    _wtn_prepare_pool_worktree "$slot" "$idx" || return
    git -C "$root" worktree move "$slot" "$target" || return

    if (( ! review )); then
      git -C "$target" checkout --no-track -B "$branch" origin/master || return
      git -C "$target" push --set-upstream origin "$branch" || return
      git -C "$target" reset --hard origin/master || return
    fi

    _wtn_copy_env "$target"
    (cd "$target" && yarn install) || return

    if (( ! no_tmux )); then
      tmux-sessionizer "$target"
    fi
  }

  _wtn_done () {
    local root="$1"
    local tree_path
    local name
    local branch
    local slot_idx
    local slot
    local current_session

    tree_path="$(git rev-parse --show-toplevel 2>/dev/null)" || {
      echo "not in a git worktree"
      return 1
    }

    if [[ "$tree_path" != "$root"/* ]]; then
      echo "$tree_path is not under $root"
      return 1
    fi

    name="${tree_path:t}"
    slot_idx="$(_wtn_read_slot_marker "$tree_path")"

    if [[ -z "$slot_idx" ]]; then
      echo "$tree_path is not a wtn worktree"
      return 1
    fi

    slot="$root/open$slot_idx"

    if [[ -e "$slot" ]]; then
      echo "pool slot already exists: $slot"
      return 1
    fi

    branch="$(git -C "$tree_path" symbolic-ref --quiet --short HEAD 2>/dev/null)"

    git -C "$tree_path" checkout -f --detach origin/master || return
    git -C "$tree_path" reset --hard origin/master || return
    git -C "$tree_path" clean -fd || return

    if [[ -n "$branch" && "$branch" != "master" ]]; then
      if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
        git -C "$root" branch -D "$branch"
      fi
    fi

    cd "$root" || return
    git -C "$root" worktree move "$tree_path" "$slot" || return
    _wtn_write_slot_marker "$slot" "$slot_idx" || return
    _wtn_copy_env "$slot"

    current_session="$(tmux display-message -p '#{session_id}')" || return
    tmux switch-client -l || return
    tmux kill-session -t "$current_session"
  }

  _wtn_rename () {
    local root="$1"
    local new_name="$2"
    local tree_path
    local new_target
    local new_branch
    local old_branch
    local old_session
    local new_session

    if [[ -z "$new_name" ]]; then
      echo "usage: wt rename <name>"
      return 1
    fi

    if [[ "$new_name" == */* ]]; then
      echo "worktree names cannot contain /"
      return 1
    fi

    if [[ "$new_name" == open<-> ]]; then
      echo "worktree names matching open<number> are reserved for the pool"
      return 1
    fi

    tree_path="$(git rev-parse --show-toplevel 2>/dev/null)" || {
      echo "not in a git worktree"
      return 1
    }

    if [[ "$tree_path" != "$root"/* ]]; then
      echo "$tree_path is not under $root"
      return 1
    fi

    new_target="$root/$new_name"

    if [[ -e "$new_target" ]]; then
      echo "worktree $new_name already exists"
      return 1
    fi

    new_branch="andre/$new_name"
    old_branch="$(git -C "$tree_path" symbolic-ref --quiet --short HEAD 2>/dev/null)"
    old_session="${${tree_path:t}//./_}"
    new_session="${new_name//./_}"

    if [[ -n "$old_branch" && "$old_branch" != "master" ]]; then
      if ! git -C "$tree_path" check-ref-format --branch "$new_branch" >/dev/null 2>&1; then
        echo "invalid branch name: $new_branch"
        return 1
      fi
    fi

    git -C "$root" worktree move "$tree_path" "$new_target" || return

    if [[ -n "$old_branch" && "$old_branch" != "master" ]]; then
      git -C "$new_target" branch -m "$old_branch" "$new_branch" || return
      git -C "$new_target" config "branch.$new_branch.remote" origin
      git -C "$new_target" config "branch.$new_branch.merge" "refs/heads/$new_branch"
    fi

    tmux-sessionizer "$new_target"

    if [[ "$old_session" != "$new_session" ]]; then
      tmux kill-session -t "$old_session" 2>/dev/null
    fi
  }

  _wtn_init_pool () {
    local root="$1"
    local pool_size="$2"
    local idx
    local slot

    if [[ ! -d "$root" ]]; then
      echo "repo root not found: $root"
      return 1
    fi

    for (( idx = 0; idx < pool_size; idx++ )); do
      slot="$root/open$idx"

      if [[ -e "$slot" ]]; then
        if ! git -C "$slot" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
          echo "$slot exists but is not a git worktree"
          return 1
        fi

        _wtn_prepare_pool_worktree "$slot" "$idx" || return
        continue
      fi

      if _wtn_slot_is_active "$root" "$idx"; then
        continue
      fi

      git -C "$root" worktree add --detach "$slot" origin/master || return
      _wtn_prepare_pool_worktree "$slot" "$idx" || return
      _wtn_copy_env "$slot"
    done
  }

  _wtn_prepare_pool_worktree () {
    local worktree_path="$1"
    local slot_idx="$2"

    git -C "$worktree_path" checkout -f --detach origin/master || return
    git -C "$worktree_path" reset --hard origin/master || return
    git -C "$worktree_path" clean -fd || return
    _wtn_write_slot_marker "$worktree_path" "$slot_idx"
  }

  _wtn_worktree_paths () {
    local root="$1"

    git -C "$root" worktree list --porcelain | awk '/^worktree / { print substr($0, 10) }'
  }

  _wtn_slot_is_active () {
    local root="$1"
    local slot_idx="$2"
    local worktree_path

    for worktree_path in "${(@f)$(_wtn_worktree_paths "$root")}"; do
      if [[ "$(_wtn_read_slot_marker "$worktree_path")" == "$slot_idx" ]]; then
        return 0
      fi
    done

    return 1
  }

  _wtn_read_slot_marker () {
    local worktree_path="$1"
    local marker

    marker="$(git -C "$worktree_path" rev-parse --git-path wtn-slot 2>/dev/null)" || return

    if [[ -f "$marker" ]]; then
      <"$marker"
    fi
  }

  _wtn_write_slot_marker () {
    local worktree_path="$1"
    local slot_idx="$2"
    local marker

    marker="$(git -C "$worktree_path" rev-parse --git-path wtn-slot 2>/dev/null)" || return
    printf "%s\n" "$slot_idx" > "$marker"
  }

  _wtn_copy_env () {
    local worktree_path="$1"
    local env_local="$worktree_path/.config/.env.local"

    if [[ -f "$worktree_path/.config/env_defaults/.env.local" ]]; then
      cp "$worktree_path/.config/env_defaults/.env.local" "$env_local"
    fi

    if [[ -f "$env_local" ]] && ! grep -q '^DISABLE_URL_BUILDER=' "$env_local"; then
      printf "DISABLE_URL_BUILDER=true\n" >> "$env_local"
    fi
  }

  local root="${WTN_ROOT:-$HOME/code/web}"
  local pool_size="${WTN_POOL_SIZE:-15}"
  local no_tmux=0
  local -a args=()
  local arg

  for arg in "$@"; do
    if [[ "$arg" == "--no-tmux" ]]; then
      no_tmux=1
    else
      args+=("$arg")
    fi
  done

  local name="$args[1]"

  if [[ -z "$name" ]]; then
    echo "usage: wt [--no-tmux] <name>|review/<name>|rename <name>|done|init"
    return 1
  fi

  if [[ "$name" == "init" ]]; then
    _wtn_init_pool "$root" "$pool_size"
    return
  fi

  if [[ "$name" == "done" ]]; then
    _wtn_done "$root"
    return
  fi

  if [[ "$name" == "rename" ]]; then
    _wtn_rename "$root" "$args[2]"
    return
  fi

  _wtn_start "$root" "$pool_size" "$name" "$no_tmux"
}
