{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": false
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/sse",
      "enabled": false
    }
  }

  // "model": "anthropic/claude-sonnet-4-5",
  // "autoupdate": true,
  // "server": {
  //   "port": 4096,
  // },
  "agent": {
    "opus-helper": {
      "description": "General helper on Claude Opus",
      "mode": "subagent",
      "model": "anthropic/claude-opus-4-6",
      "prompt": "You are a focused helper agent."
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics", "--auto-connect"],
      "enabled": false
    },
    "logrocket": {
      "type": "remote",
      "url": "https://mcp.logrocket.com/mcp",
      "enabled": false
    }
  }
}
