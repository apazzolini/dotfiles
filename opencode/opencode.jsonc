{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "~/code/**":"allow",
      "/tmp/**":"allow",
      "/Users/andre.azzolini/Desktop/**":"allow",
    },
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics", "--auto-connect"],
      "enabled": false
    },
    "logrocket": {
      "type": "remote",
      "url": "https://mcp.logrocket.com/mcp",
      "enabled": false
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": false
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/sse",
      "enabled": false
    }
  },

  "agent": {
    "opus-helper": {
      "description": "General helper on Claude Opus",
      "mode": "subagent",
      "model": "anthropic/claude-opus-4-6",
      "prompt": "You are a focused helper agent."
    }
  },
}
