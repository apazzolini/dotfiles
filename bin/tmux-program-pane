#!/bin/sh

set -e

program=$1
action=${2:-toggle}
source_pane=${3:-${TMUX_PANE:-}}
case $program in
  lazygit | nvim | pi) ;;
  *) echo "usage: tmux-program-pane <lazygit|nvim|pi> [toggle|focus|ensure] [source-pane]" >&2; exit 1 ;;
esac
case $action in
  toggle | focus | ensure) ;;
  *) echo "unknown pane action: $action" >&2; exit 1 ;;
esac
[ -n "$source_pane" ] || source_pane=$(tmux display-message -p '#{pane_id}')
state=$(tmux display-message -p -t "$source_pane" '#{window_id} #{window_zoomed_flag} #{pane_pid} #{pane_dead} #{pane_current_command} #{pane_tty} #{@program-return-pane} #{@program-return-zoom}')
read -r window zoomed source_pid source_dead source_command source_tty return_pane return_zoom <<EOF
$state
EOF
panes=$(tmux list-panes -t "$window" -F '#{pane_index} #{pane_id} #{pane_pid} #{pane_dead} #{pane_current_command} #{pane_tty}' | sort -n)
pi_resolved=false
pi_command=
pi_entrypoint=

pane_runs_program() {
  if [ "$2" = "$program" ]; then
    return 0
  fi
  if [ "$program" = pi ] && [ "$pi_resolved" = false ]; then
    pi_command=$(command -v pi || true)
    pi_entrypoint=$pi_command
    if [ -n "$pi_entrypoint" ]; then
      while link=$(readlink "$pi_entrypoint" 2>/dev/null); do
        case $link in
          /*) pi_entrypoint=$link ;;
          *) pi_entrypoint="$(dirname "$pi_entrypoint")/$link" ;;
        esac
      done
      pi_entrypoint=$(cd -P "$(dirname "$pi_entrypoint")" && printf '%s/%s\n' "$PWD" "$(basename "$pi_entrypoint")")
    fi
    pi_resolved=true
  fi
  processes=$(ps -t "${3#/dev/}" -o pid=,ppid=,comm=,args= 2>/dev/null || true)
  printf '%s\n' "$processes" | awk -v root="$1" -v program="$program" -v pi_command="$pi_command" -v pi_entrypoint="$pi_entrypoint" '
    $1 ~ /^[0-9]+$/ {
      parent[$1] = $2
      name = $3
      executable = $4
      sub(/^.*\//, "", name)
      sub(/^.*\//, "", executable)
      if (name == program) {
        matches[$1] = 1
      } else if (program == "pi" && (name == "node" || name == "bun" || executable == "node" || executable == "bun")) {
        entrypoint = ""
        run_seen = 0
        for (i = 5; i <= NF; i++) {
          arg = $i
          if (arg ~ /^(-[ep]|--eval|--print)(=|$)/ || arg ~ /^-[ep].+/) break
          if (arg == "--") {
            entrypoint = $(i + 1)
            break
          }
          if (arg ~ /^(-r|--require|--import|--loader|--experimental-loader|--conditions|-C|--env-file|--env-file-if-exists|--cwd|--preload|--config|--tsconfig-override)$/) {
            i++
            continue
          }
          if (arg ~ /^-/) continue
          if ((name == "bun" || executable == "bun") && arg == "run" && !run_seen) {
            run_seen = 1
            continue
          }
          entrypoint = arg
          break
        }
        if (entrypoint != "" && (entrypoint == pi_command || entrypoint == pi_entrypoint || entrypoint ~ /\/pi-coding-agent\/.*\/cli\.js$/)) {
          matches[$1] = 1
        }
      }
    }
    END {
      for (pid in matches) {
        current = pid
        while (current && current != root && current in parent && parent[current] != current) {
          current = parent[current]
        }
        if (current == root) exit 0
      }
      exit 1
    }
  '
}

on_program=false
if [ "$action" = toggle ] && [ "$source_dead" != 1 ] && pane_runs_program "$source_pid" "$source_command" "$source_tty"; then
  on_program=true
fi

if [ "$action" = toggle ] && [ "$on_program" = true ]; then
  target=$return_pane
  if ! printf '%s\n' "$panes" | awk -v target="$target" '$2 == target { found = 1 } END { exit !found }'; then
    target=$(tmux list-panes -t "$window" -f '#{pane_last}' -F '#{pane_id}')
    return_zoom=$zoomed
  fi
  if [ -z "$target" ] || [ "$target" = "$source_pane" ]; then
    exit 0
  fi
  if [ "$return_zoom" = 1 ]; then
    if [ "$zoomed" = 1 ]; then
      tmux select-pane -Z -t "$target"
    else
      tmux select-pane -t "$target" \; resize-pane -Z -t "$target"
    fi
  else
    tmux select-pane -t "$target"
  fi
  printf '%s\n' "$target"
  exit 0
fi

target=
while read -r index pane pid dead command tty; do
  if [ "$dead" = 1 ] || { [ "$action" = toggle ] && [ "$pane" = "$source_pane" ]; }; then
    continue
  fi
  if pane_runs_program "$pid" "$command" "$tty"; then
    target=$pane
    break
  fi
done <<EOF
$panes
EOF

if [ -z "$target" ]; then
  cwd=$(tmux display-message -p -t "$source_pane" '#{pane_current_path}')
  zoom_option=
  if [ "$zoomed" = 1 ]; then
    zoom_option=-Z
  fi
  target=$(tmux split-window -d $zoom_option -v -P -F '#{pane_id}' -t "$source_pane" -c "$cwd")
  if [ "$program" = lazygit ]; then
    tmux send-keys -l -t "$target" 'lazygit -ucd "$HOME/.config/lazygit"'
  else
    tmux send-keys -l -t "$target" "$program"
  fi
  tmux send-keys -l -t "$target" '; if [ "$(tmux display-message -p -t "$TMUX_PANE" "#{window_panes}")" -gt 1 ]; then tmux kill-pane -t "$TMUX_PANE"; fi'
  tmux send-keys -t "$target" Enter
fi

if [ "$action" != ensure ]; then
  set -- select-pane -Z -t "$target"
  if [ "$target" != "$source_pane" ]; then
    set -- set-option -pq -t "$target" @program-return-pane "$source_pane" \; \
      set-option -pq -t "$target" @program-return-zoom "$zoomed" \; "$@"
  fi
  if [ "$zoomed" != 1 ]; then
    set -- "$@" \; resize-pane -Z -t "$target"
  fi
  tmux "$@"
fi
printf '%s\n' "$target"
