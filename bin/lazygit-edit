#!/bin/sh

file=$1
line=$2

case $file in
  /*) ;;
  *) file="$PWD/$file" ;;
esac

if [ -n "${TMUX:-}" ]; then
  editor_pane=$("$(dirname "$0")/tmux-program-pane" nvim focus) || exit 1
  attempts=0
  while :; do
    server=$(tmux show-options -pqv -t "$editor_pane" @nvim-server) || exit 1
    if [ -n "$server" ] && nvim --server "$server" --remote-expr '1' </dev/null >/dev/null 2>&1; then
      break
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 600 ] || [ "$(tmux display-message -p -t "$editor_pane" '#{pane_dead}')" = 1 ]; then
      echo "timed out waiting for Neovim in pane $editor_pane" >&2
      exit 1
    fi
    sleep 0.05
  done
  if ! nvim --server "$server" --remote "$file" </dev/null >/dev/null 2>&1; then
    echo "failed to open '$file' in Neovim" >&2
    exit 1
  fi
  case $line in
    '' | *[!0-9]*) ;;
    *) nvim --server "$server" --remote-expr "cursor($line, 1)" </dev/null >/dev/null 2>&1 || exit 1 ;;
  esac
  exit 0
fi

if command -v floaterm >/dev/null 2>&1; then
  if [ -n "$line" ]; then
    floaterm "$file" "$line" >/dev/null 2>&1 && exit 0
  else
    floaterm "$file" >/dev/null 2>&1 && exit 0
  fi
fi

if [ -n "$line" ]; then
  exec nvim "+$line" -- "$file"
fi
exec nvim -- "$file"
