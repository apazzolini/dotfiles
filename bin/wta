#!/usr/bin/env zsh

wta () {
  if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    cat <<'EOF'
Usage: wta <name>|rename <name>|done|init|--help

Commands:
  <name>         Claim a pooled worktree at $WTN_ROOT/<name>, create
                 andre/<name> from origin/master, configure tracking of
                 origin/andre/<name>, copy environment defaults, and run
                 yarn install. Initializes the pool if no slots are available.
                 Does not push or attach tmux. Run git push when ready to
                 create the remote branch.
  rename <name>  From the current worktree, move it to $WTN_ROOT/<name>.
                 Rename its branch to andre/<name> unless detached or on
                 master, and update its origin tracking config. Does not
                 push the renamed branch or delete the old remote branch.
  done           From the current managed worktree, discard tracked changes
                 and untracked files/directories (excluding ignored files),
                 reset to origin/master, delete the local branch (except
                 master), and return the worktree to its pool slot.
                 In tmux, switch to the previous session and kill the current
                 session after successful cleanup, including all its panes.
  init           Create missing pool slots and reset existing pool slots to
                 origin/master, discarding tracked and non-ignored untracked
                 changes. Leave claimed slots alone.
  --help, -h     Show this help without changing anything.

Environment:
  WTN_ROOT       Worktree parent/repository root (default: $HOME/code/web).
  WTN_POOL_SIZE  Number of pool slots (default: 15).

Agent usage:
  Only create worktrees or push branches when explicitly authorized.
  Agents must never use review/<name> mode. It is reserved for manual use.
  Names cannot contain / or match open<number>; command names are reserved.
  Run rename and done from inside the target worktree.
  Creation and rename do not change the caller's working directory; cd to
  the resulting path explicitly. Use wta, not wt, for non-attaching creation.
  done and init are destructive and do not prompt. Preserve needed work first.
  done does not merge changes or delete the remote branch.
  Commands use the local origin/master ref; they do not fetch updates.
EOF
    return 0
  fi

  # Agents must never use review/<name> mode. It is reserved for manual use.
  _wtn_start () {
    local root="$1"
    local pool_size="$2"
    local name="$3"
    local review=0
    local target
    local branch
    local idx
    local slot=""

    if [[ "$name" == review/* ]]; then
      review=1
      name="review-${name#review/}"
    fi

    if [[ "$name" == */* ]]; then
      echo "worktree names cannot contain /"
      return 1
    fi

    if [[ "$name" == open<-> ]]; then
      echo "worktree names matching open<number> are reserved for the pool"
      return 1
    fi

    target="$root/$name"
    branch="andre/$name"

    if [[ -e "$target" ]]; then
      echo "worktree $name already exists"
      return 1
    fi

    if (( ! review )) && ! git -C "$root" check-ref-format --branch "$branch" >/dev/null 2>&1; then
      echo "invalid branch name: $branch"
      return 1
    fi

    for (( idx = 0; idx < pool_size; idx++ )); do
      if [[ -d "$root/open$idx" ]]; then
        slot="$root/open$idx"
        break
      fi
    done

    if [[ -z "$slot" ]]; then
      _wtn_init_pool "$root" "$pool_size" || return

      for (( idx = 0; idx < pool_size; idx++ )); do
        if [[ -d "$root/open$idx" ]]; then
          slot="$root/open$idx"
          break
        fi
      done
    fi

    if [[ -z "$slot" ]]; then
      echo "no open worktrees available"
      return 1
    fi

    _wtn_prepare_pool_worktree "$slot" "$idx" || return
    git -C "$root" worktree move "$slot" "$target" || return

    if (( ! review )); then
      git -C "$target" checkout --no-track -B "$branch" origin/master || return
      git -C "$target" config "branch.$branch.remote" origin || return
      git -C "$target" config "branch.$branch.merge" "refs/heads/$branch" || return
      git -C "$target" reset --hard origin/master || return
    fi

    _wtn_copy_env "$target"
    (cd "$target" && yarn install) || return
  }

  _wtn_done () {
    local root="$1"
    local tree_path
    local name
    local branch
    local slot_idx
    local slot

    tree_path="$(git rev-parse --show-toplevel 2>/dev/null)" || {
      echo "not in a git worktree"
      return 1
    }

    if [[ "$tree_path" != "$root"/* ]]; then
      echo "$tree_path is not under $root"
      return 1
    fi

    name="${tree_path:t}"
    slot_idx="$(_wtn_read_slot_marker "$tree_path")"

    if [[ -z "$slot_idx" ]]; then
      echo "$tree_path is not a wtn worktree"
      return 1
    fi

    slot="$root/open$slot_idx"

    if [[ -e "$slot" ]]; then
      echo "pool slot already exists: $slot"
      return 1
    fi

    branch="$(git -C "$tree_path" symbolic-ref --quiet --short HEAD 2>/dev/null)"

    git -C "$tree_path" checkout -f --detach origin/master || return
    git -C "$tree_path" reset --hard origin/master || return
    git -C "$tree_path" clean -fd || return

    if [[ -n "$branch" && "$branch" != "master" ]]; then
      if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
        git -C "$root" branch -D "$branch"
      fi
    fi

    cd "$root" || return
    git -C "$root" worktree move "$tree_path" "$slot" || return
    _wtn_write_slot_marker "$slot" "$slot_idx" || return
    _wtn_copy_env "$slot"
  }

  _wtn_rename () {
    local root="$1"
    local new_name="$2"
    local tree_path
    local new_target
    local new_branch
    local old_branch

    if [[ -z "$new_name" ]]; then
      echo "usage: wta rename <name>"
      return 1
    fi

    if [[ "$new_name" == */* ]]; then
      echo "worktree names cannot contain /"
      return 1
    fi

    if [[ "$new_name" == open<-> ]]; then
      echo "worktree names matching open<number> are reserved for the pool"
      return 1
    fi

    tree_path="$(git rev-parse --show-toplevel 2>/dev/null)" || {
      echo "not in a git worktree"
      return 1
    }

    if [[ "$tree_path" != "$root"/* ]]; then
      echo "$tree_path is not under $root"
      return 1
    fi

    new_target="$root/$new_name"

    if [[ -e "$new_target" ]]; then
      echo "worktree $new_name already exists"
      return 1
    fi

    new_branch="andre/$new_name"
    old_branch="$(git -C "$tree_path" symbolic-ref --quiet --short HEAD 2>/dev/null)"

    if [[ -n "$old_branch" && "$old_branch" != "master" ]]; then
      if ! git -C "$tree_path" check-ref-format --branch "$new_branch" >/dev/null 2>&1; then
        echo "invalid branch name: $new_branch"
        return 1
      fi
    fi

    git -C "$root" worktree move "$tree_path" "$new_target" || return

    if [[ -n "$old_branch" && "$old_branch" != "master" ]]; then
      git -C "$new_target" branch -m "$old_branch" "$new_branch" || return
      git -C "$new_target" config "branch.$new_branch.remote" origin
      git -C "$new_target" config "branch.$new_branch.merge" "refs/heads/$new_branch"
    fi

  }

  _wtn_init_pool () {
    local root="$1"
    local pool_size="$2"
    local idx
    local slot

    if [[ ! -d "$root" ]]; then
      echo "repo root not found: $root"
      return 1
    fi

    for (( idx = 0; idx < pool_size; idx++ )); do
      slot="$root/open$idx"

      if [[ -e "$slot" ]]; then
        if ! git -C "$slot" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
          echo "$slot exists but is not a git worktree"
          return 1
        fi

        _wtn_prepare_pool_worktree "$slot" "$idx" || return
        continue
      fi

      if _wtn_slot_is_active "$root" "$idx"; then
        continue
      fi

      git -C "$root" worktree add --detach "$slot" origin/master || return
      _wtn_prepare_pool_worktree "$slot" "$idx" || return
      _wtn_copy_env "$slot"
    done
  }

  _wtn_prepare_pool_worktree () {
    local worktree_path="$1"
    local slot_idx="$2"

    git -C "$worktree_path" checkout -f --detach origin/master || return
    git -C "$worktree_path" reset --hard origin/master || return
    git -C "$worktree_path" clean -fd || return
    _wtn_write_slot_marker "$worktree_path" "$slot_idx"
  }

  _wtn_worktree_paths () {
    local root="$1"

    git -C "$root" worktree list --porcelain | awk '/^worktree / { print substr($0, 10) }'
  }

  _wtn_slot_is_active () {
    local root="$1"
    local slot_idx="$2"
    local worktree_path

    for worktree_path in "${(@f)$(_wtn_worktree_paths "$root")}"; do
      if [[ "$(_wtn_read_slot_marker "$worktree_path")" == "$slot_idx" ]]; then
        return 0
      fi
    done

    return 1
  }

  _wtn_read_slot_marker () {
    local worktree_path="$1"
    local marker

    marker="$(git -C "$worktree_path" rev-parse --git-path wtn-slot 2>/dev/null)" || return

    if [[ -f "$marker" ]]; then
      <"$marker"
    fi
  }

  _wtn_write_slot_marker () {
    local worktree_path="$1"
    local slot_idx="$2"
    local marker

    marker="$(git -C "$worktree_path" rev-parse --git-path wtn-slot 2>/dev/null)" || return
    printf "%s\n" "$slot_idx" > "$marker"
  }

  _wtn_copy_env () {
    local worktree_path="$1"
    local env_local="$worktree_path/.config/.env.local"

    if [[ -f "$worktree_path/.config/env_defaults/.env.local" ]]; then
      cp "$worktree_path/.config/env_defaults/.env.local" "$env_local"
    fi

    if [[ -f "$env_local" ]] && ! grep -q '^DISABLE_URL_BUILDER=' "$env_local"; then
      printf "DISABLE_URL_BUILDER=true\n" >> "$env_local"
    fi
  }

  local root="${WTN_ROOT:-$HOME/code/web}"
  local pool_size="${WTN_POOL_SIZE:-15}"
  local arg

  for arg in "$@"; do
    if [[ "$arg" == "--no-tmux" ]]; then
      echo "--no-tmux is no longer supported; use wta to create without attaching or wt to create and attach"
      return 1
    fi
  done

  local name="$1"

  if [[ -z "$name" ]]; then
    echo "usage: wta <name>|review/<name>|rename <name>|done|init|--help"
    echo "Agents must never use review/<name> mode. It is reserved for manual use."
    return 1
  fi

  if [[ "$name" == "init" ]]; then
    _wtn_init_pool "$root" "$pool_size"
    return
  fi

  if [[ "$name" == "done" ]]; then
    _wtn_done "$root" || return
    if [[ -n "$TMUX" ]]; then
      local current_session
      current_session="$(tmux display-message -p '#{session_id}')" || return
      tmux switch-client -l || return
      tmux kill-session -t "$current_session"
    fi
    return
  fi

  if [[ "$name" == "rename" ]]; then
    _wtn_rename "$root" "$2"
    return
  fi

  _wtn_start "$root" "$pool_size" "$name"
}

wta "$@"
