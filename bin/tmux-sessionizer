#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    ARRAY=("$HOME/.dotfiles")

    if [[ "$(hostname)" =~ andrem2 ]]; then
      ARRAY+=($(find ~/Work/server -mindepth 1 -maxdepth 1 -type d -not -path '*/.*'))
      ARRAY+=($(find ~/Work -mindepth 1 -maxdepth 1 -type d -not -path '*/.*'))
    elif [[ "$(hostname)" =~ arch ]]; then
      ARRAY+=($(find ~/code/web -mindepth 1 -maxdepth 1 -type d -not -path '*/.*'))
      # ARRAY+=($(find ~/Work -mindepth 1 -maxdepth 1 -type d -not -path '*/.*'))
    elif [[ "$(hostname)" == "G16JTXJGPY" ]]; then
      ARRAY+=($(find ~/work -mindepth 1 -maxdepth 1 -type d -not -path '*/.*'))
      ARRAY+=("$HOME/work/notes")
    fi

    ARRAY+=($(find ~/code ~/code/_forks -mindepth 1 -maxdepth 1 -type d | sort))

    selected=$(printf "%s\n" "${ARRAY[@]}" | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux -u -2 new-session -s $selected_name -c $selected
    exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

if [[ -z $TMUX ]]; then
    tmux -2 attach -t $selected_name
else
  tmux switch-client -t $selected_name
fi
